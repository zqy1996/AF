stratified_balance <- function(cells_high, cells_low, labels_vec, min_per_label = 10, seed = 123) {
  set.seed(seed)
  lab_high <- labels_vec[cells_high]; lab_low <- labels_vec[cells_low]
  labs <- union(names(table(lab_high)), names(table(lab_low)))
  keep_high <- c(); keep_low <- c()
  for (lab in labs) {
    ch <- names(lab_high[lab_high == lab]); cl <- names(lab_low[lab_low == lab])
    n <- min(length(ch), length(cl))
    if (n >= min_per_label) {
      keep_high <- c(keep_high, sample(ch, n))
      keep_low  <- c(keep_low,  sample(cl, n))
    }
  }
  list(high = keep_high, low = keep_low)
}

