sanitize_subset <- function(seurat_obj, cells, group_col = "celltype_group", min_cells = 1) {
  meta <- seurat_obj[[]][cells, , drop = FALSE]
  
  meta[[group_col]] <- droplevels(factor(as.character(meta[[group_col]])))
  tab <- table(meta[[group_col]])

  drop_lvls <- names(tab)[tab < min_cells]
  if (length(drop_lvls)) {
    keep_cells <- cells[!(meta[[group_col]] %in% drop_lvls)]
    meta <- seurat_obj[[]][keep_cells, , drop = FALSE]
    meta[[group_col]] <- droplevels(factor(as.character(meta[[group_col]])))
    cells <- keep_cells
  }
  list(cells = cells, table = table(meta[[group_col]]))
}

