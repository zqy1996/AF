pad_reorder <- function(mat, genes) {
  miss <- setdiff(genes, rownames(mat))
  if (length(miss) > 0) {
    mat <- rbind(
      mat,
      Matrix(0, nrow = length(miss), ncol = ncol(mat),
             sparse = TRUE, dimnames = list(miss, colnames(mat)))
    )
  }
  mat[genes, , drop = FALSE]
}

