split_by_quantile_disjoint <- function(gx, p = 0.25) {
  ql <- quantile(gx, p, na.rm = TRUE)
  qh <- quantile(gx, 1 - p, na.rm = TRUE)
  # 
  low  <- names(gx)[gx < ql]
  high <- names(gx)[gx > qh]
  # 
  if (length(low) == 0 || length(high) == 0) {
    ord <- order(gx, na.last = NA)
    k <- max(1, floor(length(gx) * p))
    low  <- names(gx)[head(ord, k)]
    high <- names(gx)[tail(ord, k)]
  }
  list(low = low, high = high)
}

stratified_split <- function(vals, groups, p = 0.25, min_cells_per_group = 2L, verbose = TRUE) {
  stopifnot(length(vals) == length(groups))
  
  keep <- !is.na(vals) & !is.na(groups)
  vals <- vals[keep]
  groups <- groups[keep]
  
  
  res_low  <- character(0)
  res_high <- character(0)
  
  
  skipped <- list()
  
  for (g in unique(groups)) {
    idx <- which(groups == g)
    if (length(idx) < min_cells_per_group) {
      skipped[[g]] <- sprintf("too few cells: %d < %d", length(idx), min_cells_per_group)
      next
    }
    
    gx <- vals[idx]
    names(gx) <- names(vals)[idx]
    
    sp <- split_by_quantile_disjoint(gx, p = p)
    
    n_low  <- length(sp$low)
    n_high <- length(sp$high)
    
    if (n_low == 0L && n_high == 0L) {
      skipped[[g]] <- "both empty after split"
      next
    }
    
    # 
    if (n_low == 0L || n_high == 0L) {
      skipped[[g]] <- sprintf("one side empty: low=%d, high=%d", n_low, n_high)
    }
    
    res_low  <- c(res_low,  sp$low)
    res_high <- c(res_high, sp$high)
  }
  
  if (verbose) {
    if (length(skipped)) {
      msg <- paste(sprintf("- %s: %s", names(skipped), unlist(skipped)), collapse = "\n")
      message("Skipped subtypes due to constraints:\n", msg)
    } else {
      message("No subtypes skipped.")
    }
    message(sprintf("Collected cells: low=%d, high=%d", length(res_low), length(res_high)))
  }
  list(low = res_low, high = res_high, skipped = skipped)
}

