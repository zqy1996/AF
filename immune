run_cellchat_counts_merged <- function(seuratdta, cells_subset, min_cells = 10, project_name = "CellChat") {
  library(CellChat)
  library(Matrix)
  message("获取合并层数据...")
  if (!"counts_merged" %in% Layers(seuratdta[["RNA"]])) {
    stop("Seurat对象中未找到'counts_merged'层。请确保已按照之前的代码创建该层")
  }
  
  data.input <- LayerData(seuratdta, assay = "RNA", layer = "counts_merged")
  
  valid_cells <- intersect(cells_subset, colnames(data.input))
  if (length(valid_cells) == 0) {
    stop("没有任何细胞存在于表达矩阵中。请检查细胞ID是否匹配")
  }
  
  if (length(valid_cells) < length(cells_subset)) {
    warning("过滤掉了 ", length(cells_subset) - length(valid_cells), 
            " 个不存在于表达矩阵中的细胞")
  }
  
  data.input <- data.input[, valid_cells, drop = FALSE]
  
  
  meta <- seuratdta[[]][valid_cells, , drop = FALSE]
  
  cell_type_col <- "celltype_group"
  if (!cell_type_col %in% colnames(meta)) {
    stop("在元数据中找不到列：'", cell_type_col, "'。可用列：",
         paste(colnames(meta), collapse = ", "))
  }
  
  message("创建CellChat对象...")
  cellchat <- createCellChat(
    object = data.input,
    meta = meta,
    group.by = cell_type_col
  )
  
  try({
    if ("project.name" %in% slotNames(cellchat)) {
      cellchat@project.name <- project_name
    } else if ("projectName" %in% slotNames(cellchat)) {
      cellchat@projectName <- project_name
    } else {
      message("当前CellChat版本不支持设置项目名称")
    }
  }, silent = TRUE)
  
  message("加载CellChat数据库...")
  CellChatDB <- CellChatDB.human
  cellchat@DB <- CellChatDB
  
  message("设置细胞身份...")
  cellchat <- setIdent(cellchat, ident.use = cell_type_col)
  
  message(">> 数据子集化")
  cellchat <- subsetData(cellchat)
  
  message(">> 识别过表达基因")
  cellchat <- identifyOverExpressedGenes(cellchat)
  
  message(">> 识别过表达相互作用")
  cellchat <- identifyOverExpressedInteractions(cellchat)
  
  message(">> 计算通讯概率 (敏感模式)")
  cellchat <- computeCommunProb(cellchat,
                                type = "truncatedMean",
                                trim = 0.1,
                                population.size = TRUE)
  
  message(">> 过滤微弱信号")
  cellchat <- filterCommunication(cellchat, min.cells = min_cells)
  
  message(">> 通路水平分析")
  cellchat <- computeCommunProbPathway(cellchat)
  
  message(">> 网络聚合")
  cellchat <- aggregateNet(cellchat)
  
  message("分析完成! 返回CellChat对象")
  return(cellchat)
}
